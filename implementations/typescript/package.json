{
	"name": "aeon-typescript",
	"private": true,
	"type": "module",
	"scripts": {
		"bootstrap": "pnpm install && pnpm build",
		"build": "pnpm -r --filter './packages/**' --filter './tools/**' build",
		"typecheck": "pnpm -r --filter './packages/**' --filter './tools/**' typecheck",
		"test": "pnpm -r --filter './packages/**' --filter './tools/**' test",
		"test:unit:ci": "pnpm -r --filter './packages/**' --filter './tools/**' --filter '!@altopelago/aeon-phase-fuzz' test",
		"test:stress": "cargo build --manifest-path ../rust/Cargo.toml -p aeon-cli && bash ../../scripts/stress-smoke.sh && pnpm -C ../../stress-tests/tools/aeon-stress-cli stress-advanced",
		"test:fuzz": "pnpm --filter @altopelago/aeon-phase-fuzz test",
		"test:fuzz:lexer": "pnpm --filter @altopelago/aeon-phase-fuzz fuzz:lexer",
		"test:fuzz:parser": "pnpm --filter @altopelago/aeon-phase-fuzz fuzz:parser",
		"test:fuzz:parser:duplicates": "pnpm --filter @altopelago/aeon-phase-fuzz fuzz:parser:duplicates",
		"test:fuzz:parser:duplicate-attributes": "pnpm --filter @altopelago/aeon-phase-fuzz fuzz:parser:duplicate-attributes",
		"lint": "pnpm -r --filter './packages/**' --filter './tools/**' typecheck",
		"depcheck": "node ./tools/depcheck.mjs",
		"pack:preflight": "node ./tools/package-preflight.mjs",
		"publish:preflight": "pnpm build && pnpm pack:preflight",
		"publish:npm": "node ./tools/publish-npm-packages.mjs",
		"publish:npm:dry-run": "node ./tools/publish-npm-packages.mjs --dry-run --no-provenance",
		"test:cts": "node ../../scripts/ensure-typescript-build.mjs && node ../../scripts/run-with-repo-paths.mjs node ./tools/cts-runner/dist/index.js --sut ./packages/aeos/dist/bin/aeos-validator.js --cts ../../cts/aeos/v1/aeos-validator-cts.v1.json",
		"test:cts:core": "node ../../scripts/ensure-typescript-build.mjs && node ../../scripts/run-with-repo-paths.mjs node ../../scripts/cts-source-lane-runner.mjs --sut ./packages/cli/dist/main.js --cts ../../cts/core/v1/core-cts.v1.json --lane core",
		"test:cts:aes": "node ../../scripts/ensure-typescript-build.mjs && node ../../scripts/run-with-repo-paths.mjs node ../../scripts/cts-source-lane-runner.mjs --sut ./packages/cli/dist/main.js --cts ../../cts/aes/v1/aes-cts.v1.json --lane aes",
		"test:cts:canonical": "node ../../scripts/ensure-typescript-build.mjs && node ../../scripts/run-with-repo-paths.mjs node ../../scripts/cts-source-lane-runner.mjs --sut ./packages/cli/dist/main.js --cts ../../cts/canonical/v1/canonical-cts.v1.json --lane canonical",
		"test:cts:sansa": "pnpm test:cts:sansa:literals && pnpm test:cts:sansa:resolve",
		"test:cts:sansa:literals": "node ../../scripts/ensure-typescript-build.mjs && node ../../scripts/run-with-repo-paths.mjs node ../../scripts/cts-source-lane-runner.mjs --sut ./packages/cli/dist/main.js --cts ../../cts/sansa/v1/sansa-aeon-address-literals-cts.v1.json --lane sansa-address",
		"test:cts:sansa:resolve": "node ../../scripts/ensure-typescript-build.mjs && node ../../scripts/run-with-repo-paths.mjs node ./tools/sansa-resolve-cts-runner/dist/index.js --cts ../../cts/sansa/v1/sansa-resolve-cts.v1.json",
		"test:cts:annotations": "node ../../scripts/ensure-typescript-build.mjs && node ../../scripts/run-with-repo-paths.mjs node ./tools/annotation-cts-runner/dist/index.js --sut ./packages/cli/dist/main.js --cts ../../cts/annotations/v1/annotation-stream-cts.v1.json",
		"test:cts:all": "pnpm test:cts && pnpm test:cts:core && pnpm test:cts:aes && pnpm test:cts:canonical && pnpm test:cts:sansa && pnpm test:cts:annotations",
		"ci:typescript": "pnpm build && pnpm typecheck && pnpm lint && pnpm depcheck && pnpm test:unit:ci && pnpm test:fuzz && pnpm test:stress && pnpm test:cts:all",
		"ci:canonical": "pnpm build && cd ../rust && cargo build -p aeon-cli && cd ../typescript && bash ../../scripts/canonical-cts.sh --mode all --brief",
		"ci": "pnpm ci:typescript && pnpm ci:canonical",
		"clean": "pnpm -r --filter './packages/**' --filter './tools/**' clean"
	},
	"devDependencies": {
		"typescript": "7.0.2",
		"@types/node": "26.1.2"
	},
	"packageManager": "pnpm@10.34.4",
	"engines": {
		"node": ">=20.0.0"
	}
}
