{
  "name": "@altopelago/aeon-finalize",
  "version": "0.9.4",
  "description": "AEON finalization and diagnostic helpers for the TypeScript implementation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltoPelago/aeon.git",
    "directory": "implementations/typescript/packages/finalize"
  },
  "bugs": {
    "url": "https://github.com/AltoPelago/aeon/issues"
  },
  "homepage": "https://github.com/AltoPelago/aeon/tree/main/implementations/typescript/packages/finalize#readme",
  "keywords": [
    "aeon",
    "aeonite",
    "parser",
    "schema",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@altopelago/aeon-aes": "workspace:*"
  },
  "devDependencies": {
    "@altopelago/aeon-parser": "workspace:*",
    "@altopelago/aeon-lexer": "workspace:*"
  }
}
