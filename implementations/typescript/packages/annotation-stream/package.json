{
  "name": "@altopelago/aeon-annotation-stream",
  "version": "0.9.6",
  "description": "Build AEON annotation streams from comments, attributes, and source metadata.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltoPelago/aeon.git",
    "directory": "implementations/typescript/packages/annotation-stream"
  },
  "bugs": {
    "url": "https://github.com/AltoPelago/aeon/issues"
  },
  "homepage": "https://github.com/AltoPelago/aeon/tree/main/implementations/typescript/packages/annotation-stream#readme",
  "keywords": [
    "aeon",
    "aeonite",
    "annotations",
    "comments",
    "metadata",
    "source-map",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js",
    "perf:annotations": "pnpm --dir ../core build && pnpm build && node ./scripts/perf-annotations.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@altopelago/aeon-aes": "workspace:*",
    "@altopelago/aeon-lexer": "workspace:*"
  }
}
