{
  "name": "@altopelago/aeos-core",
  "version": "0.12.1",
  "description": "AEOS schema validation runtime and CLI for AEON documents.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aeos-validator": "./dist/bin/aeos-validator.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltoPelago/aeon.git",
    "directory": "implementations/typescript/packages/aeos"
  },
  "bugs": {
    "url": "https://github.com/AltoPelago/aeon/issues"
  },
  "homepage": "https://github.com/AltoPelago/aeon/tree/main/implementations/typescript/packages/aeos#readme",
  "keywords": [
    "aeon",
    "aeonite",
    "parser",
    "schema",
    "typescript"
  ],
  "dependencies": {
    "@altopelago/aeon-aes": "workspace:*",
    "@altopelago/aeon-core": "workspace:*",
    "@altopelago/aeon-finalize": "workspace:*",
    "@altopelago/sansa": "0.10.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-name-pattern='.*' dist/*.test.js dist/rules/*.test.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@altopelago/aeon-lexer": "workspace:*"
  }
}
