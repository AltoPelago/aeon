{
  "name": "@altopelago/aeon-wasm",
  "version": "0.10.0",
  "description": "Browser-friendly WebAssembly wrapper for the Rust AEON implementation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "pkg",
    "README.md",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltoPelago/aeon.git",
    "directory": "implementations/typescript/packages/wasm"
  },
  "bugs": {
    "url": "https://github.com/AltoPelago/aeon/issues"
  },
  "homepage": "https://github.com/AltoPelago/aeon/tree/main/implementations/typescript/packages/wasm#readme",
  "keywords": [
    "aeon",
    "aeonite",
    "parser",
    "schema",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "node ./scripts/build-wasm.mjs",
    "test": "node --test dist/*.test.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean:wasm": "rm -rf pkg"
  }
}
