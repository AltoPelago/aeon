{
  "name": "@altopelago/aeon-cli",
  "version": "0.12.1",
  "description": "Command-line tools for parsing, finalizing, and inspecting AEON documents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aeon": "./dist/main.js"
  },
  "files": [
    "dist",
    "OUTPUT_CONTRACT.md",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.d.ts.map",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltoPelago/aeon.git",
    "directory": "implementations/typescript/packages/cli"
  },
  "bugs": {
    "url": "https://github.com/AltoPelago/aeon/issues"
  },
  "homepage": "https://github.com/AltoPelago/aeon/tree/main/implementations/typescript/packages/cli#readme",
  "keywords": [
    "aeon",
    "aeonite",
    "cli",
    "command-line",
    "validation",
    "formatter",
    "integrity",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@altopelago/aeon-aes": "workspace:*",
    "@altopelago/aeon-canonical": "workspace:*",
    "@altopelago/aeon-core": "workspace:*",
    "@altopelago/aeon-finalize": "workspace:*",
    "@altopelago/aeon-integrity": "workspace:*",
    "@altopelago/aeon-lexer": "workspace:*",
    "@altopelago/aeon-parser": "workspace:*",
    "@altopelago/aeon-profiles": "workspace:*",
    "@altopelago/aeon-transport": "workspace:*",
    "@altopelago/aeon-tonic": "workspace:*",
    "@altopelago/aeos-core": "workspace:*"
  }
}
