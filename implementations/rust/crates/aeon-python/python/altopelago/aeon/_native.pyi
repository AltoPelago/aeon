from typing import Any, final

ENGINE: str

@final
class Position:
    def __init__(self, line: int, column: int, offset: int) -> None: ...
    @property
    def line(self) -> int: ...
    @property
    def column(self) -> int: ...
    @property
    def offset(self) -> int: ...

@final
class Span:
    def __init__(self, start: Position, end: Position) -> None: ...
    @property
    def start(self) -> Position: ...
    @property
    def end(self) -> Position: ...

@final
class Diagnostic:
    def __init__(
        self,
        code: str,
        message: str,
        path: str | None = None,
        span: Span | None = None,
        phase: str | None = None,
    ) -> None: ...
    @property
    def code(self) -> str: ...
    @property
    def message(self) -> str: ...
    @property
    def path(self) -> str | None: ...
    @property
    def span(self) -> Span | None: ...
    @property
    def phase(self) -> str | None: ...

@final
class Event:
    def __init__(
        self,
        path: str,
        key: str,
        source_plane: str,
        datatype: str | None,
        value_type: str,
        structural_id: str | None,
        span: Span,
    ) -> None: ...
    @property
    def path(self) -> str: ...
    @property
    def key(self) -> str: ...
    @property
    def source_plane(self) -> str: ...
    @property
    def datatype(self) -> str | None: ...
    @property
    def value_type(self) -> str: ...
    @property
    def structural_id(self) -> str | None: ...
    @property
    def span(self) -> Span: ...

@final
class CompileResult:
    def __init__(
        self,
        events: tuple[Event, ...],
        warnings: tuple[Diagnostic, ...],
        errors: tuple[Diagnostic, ...],
    ) -> None: ...
    @property
    def events(self) -> tuple[Event, ...]: ...
    @property
    def warnings(self) -> tuple[Diagnostic, ...]: ...
    @property
    def errors(self) -> tuple[Diagnostic, ...]: ...
    @property
    def ok(self) -> bool: ...
    def require_ok(self) -> CompileResult: ...

@final
class Value:
    @property
    def kind(self) -> str: ...
    @property
    def canonical(self) -> str | None: ...
    @property
    def decoded(self) -> object: ...

@final
class Clarifier:
    @property
    def kind(self) -> str: ...
    @property
    def value(self) -> str: ...

@final
class GenericArgument:
    @property
    def kind(self) -> str: ...
    @property
    def datatype(self) -> str | None: ...
    @property
    def value(self) -> str | None: ...
    @property
    def generics(self) -> tuple[GenericArgument, ...]: ...
    @property
    def clarifiers(self) -> tuple[Clarifier, ...]: ...

@final
class Capabilities:
    @property
    def source_bytes(self) -> str: ...
    @property
    def authored_lexemes(self) -> str: ...
    @property
    def origin(self) -> str: ...
    @property
    def span(self) -> str: ...
    @property
    def portable_extensions(self) -> str: ...
    @property
    def unknown_telex_fields(self) -> str: ...
    @property
    def event_order(self) -> str: ...
    @property
    def lineage(self) -> str: ...

@final
class Binding:
    @property
    def address(self) -> str: ...
    @property
    def full_address(self) -> str: ...
    @property
    def event_address(self) -> str | None: ...
    @property
    def name(self) -> str | None: ...
    @property
    def position(self) -> int | None: ...
    @property
    def source_plane(self) -> str | None: ...
    @property
    def representation_kind(self) -> str: ...
    @property
    def identity(self) -> str | None: ...
    @property
    def datatype(self) -> str | None: ...
    @property
    def generics(self) -> tuple[GenericArgument, ...]: ...
    @property
    def clarifiers(self) -> tuple[Clarifier, ...]: ...
    @property
    def value(self) -> Value: ...
    @property
    def origin(self) -> str | None: ...
    @property
    def span(self) -> str | None: ...
    @property
    def parent(self) -> Binding | None: ...
    @property
    def children(self) -> tuple[Binding, ...]: ...
    @property
    def attributes(self) -> Binding | None: ...
    @property
    def lineage(self) -> str: ...
    @property
    def event_ordinal(self) -> int | None: ...
    def member(self, name: str) -> Binding: ...
    def at_position(self, index: int) -> Binding: ...
    def __getitem__(self, key: str | int) -> Binding: ...
    def __len__(self) -> int: ...

@final
class QueryScalar:
    @property
    def family(self) -> str: ...
    @property
    def canonical(self) -> str | None: ...
    @property
    def semantic_type(self) -> str | None: ...
    @property
    def decoded(self) -> object: ...

@final
class QueryContainer:
    @property
    def kind(self) -> str: ...
    @property
    def payload(self) -> _QueryValue: ...

type _QueryValue = QueryScalar | QueryContainer | tuple[Binding, ...] | QueryObject | tuple[_QueryValue, ...] | None
type _MutationValueView = QueryScalar | QueryObject | tuple[_MutationValueView, ...] | None

@final
class QueryField:
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> _QueryValue: ...

@final
class QueryObject:
    @property
    def fields(self) -> tuple[QueryField, ...]: ...
    def __getitem__(
        self, name: str
    ) -> _QueryValue: ...
    def __len__(self) -> int: ...

@final
class QueryRecord:
    @property
    def candidate(self) -> Binding: ...
    @property
    def value(self) -> _QueryValue: ...

@final
class SansaDiagnostic:
    @property
    def code(self) -> str: ...
    @property
    def message(self) -> str: ...
    @property
    def phase(self) -> str | None: ...
    @property
    def selector_index(self) -> int | None: ...
    @property
    def candidate_address(self) -> str | None: ...
    @property
    def budget(self) -> str | None: ...
    @property
    def limit(self) -> int | None: ...
    @property
    def observed(self) -> int | None: ...

@final
class SansaCapabilities:
    @property
    def query(self) -> str: ...
    @property
    def dynamic_address_activation(self) -> str: ...
    @property
    def local_spaces(self) -> str: ...
    @property
    def transform(self) -> str: ...
    @property
    def instruction(self) -> str: ...
    @property
    def mutate(self) -> str: ...
    @property
    def mutate_plan(self) -> str: ...
    @property
    def mutate_target_validation(self) -> str: ...
    @property
    def mutate_apply(self) -> str: ...

@final
class MutationDiagnostic:
    @property
    def code(self) -> str: ...
    @property
    def message(self) -> str: ...
    @property
    def phase(self) -> str: ...
    @property
    def operation_index(self) -> int | None: ...
    @property
    def precondition_index(self) -> int | None: ...
    @property
    def budget(self) -> str | None: ...
    @property
    def limit(self) -> int | None: ...
    @property
    def observed(self) -> int | None: ...
    @property
    def request_field(self) -> str | None: ...
    @property
    def operation_field(self) -> str | None: ...
    @property
    def target_format(self) -> str | None: ...
    @property
    def datatype(self) -> str | None: ...
    @property
    def value_path(self) -> str | None: ...

@final
class MutationTarget:
    @property
    def requested_address(self) -> str: ...
    @property
    def canonical_address(self) -> str: ...
    @property
    def representation_kind(self) -> str | None: ...
    @property
    def binding(self) -> Binding: ...
    @property
    def portability_warnings(self) -> tuple[SansaDiagnostic, ...]: ...

@final
class MutationPrecondition:
    @property
    def expression(self) -> str: ...
    @property
    def canonical(self) -> str: ...
    @property
    def target(self) -> MutationTarget | None: ...
    @property
    def portability_warnings(self) -> tuple[SansaDiagnostic, ...]: ...

@final
class MutationOperation:
    @property
    def op(self) -> str: ...
    @property
    def target(self) -> MutationTarget | None: ...
    @property
    def parent(self) -> MutationTarget | None: ...
    @property
    def source(self) -> MutationTarget | None: ...
    @property
    def container(self) -> MutationTarget | None: ...
    @property
    def name(self) -> str | None: ...
    @property
    def has_value(self) -> bool: ...
    @property
    def value(self) -> _MutationValueView: ...
    @property
    def datatype(self) -> str | None: ...
    @property
    def kind(self) -> str | None: ...
    @property
    def placement(self) -> str | None: ...
    @property
    def anchor(self) -> MutationTarget | None: ...
    @property
    def provenance(self) -> _MutationValueView: ...

@final
class MutationValidation:
    @property
    def ok(self) -> bool: ...
    @property
    def errors(self) -> tuple[MutationDiagnostic, ...]: ...

@final
class MutationPlan:
    @property
    def plan_version(self) -> str: ...
    @property
    def plan_id(self) -> str | None: ...
    @property
    def operations(self) -> tuple[MutationOperation, ...]: ...
    @property
    def preconditions(self) -> tuple[MutationPrecondition, ...]: ...
    @property
    def source_provenance(self) -> _MutationValueView: ...
    @property
    def diagnostics(self) -> tuple[MutationDiagnostic, ...]: ...
    @property
    def portability_warnings(self) -> tuple[SansaDiagnostic, ...]: ...
    def validate_target(self, target: str = "aeon") -> MutationValidation: ...

@final
class MutationResult:
    @property
    def ok(self) -> bool: ...
    @property
    def plan(self) -> MutationPlan | None: ...
    @property
    def errors(self) -> tuple[MutationDiagnostic, ...]: ...

@final
class QueryResult:
    @property
    def ok(self) -> bool: ...
    @property
    def results(self) -> tuple[QueryRecord, ...]: ...
    @property
    def errors(self) -> tuple[SansaDiagnostic, ...]: ...

@final
class Document:
    def plan_mutation(
        self,
        request: dict[str, Any],
        *,
        scope: str = "payload",
        profile: str = "aeon.value.default.v1",
        budget: dict[str, int] | None = None,
        max_bindings: int = 100_000,
        max_position_index: int = 999_999,
        plan_id: str | None = None,
    ) -> MutationResult: ...
    @property
    def source(self) -> str: ...
    @property
    def payload(self) -> Binding: ...
    @property
    def header(self) -> Binding: ...
    @property
    def full(self) -> Binding: ...
    @property
    def capabilities(self) -> Capabilities: ...
    @property
    def sansa_capabilities(self) -> SansaCapabilities: ...
    def __getitem__(self, name: str) -> Binding: ...
    def at(self, address: str, scope: str = "payload") -> Binding: ...
    def by_identity(
        self, identity: str, scope: str = "payload"
    ) -> tuple[Binding, ...]: ...
    def query(
        self,
        query: str,
        *,
        scope: str = "payload",
        profile: str = "aeon.value.default.v1",
        policy: str = "general",
        max_from_bindings: int | None = None,
        max_where_candidates: int | None = None,
        max_order_candidates: int | None = None,
        max_result_records: int | None = None,
        activation_roots: tuple[str, ...] | list[str] | None = None,
        activation_selectors: tuple[str, ...] | list[str] | None = None,
        allow_contextual_activation: bool = False,
        max_activation_depth: int | None = None,
        max_activation_bindings: int | None = None,
    ) -> QueryResult: ...

def scalar(
    family: str, canonical: str, *, semantic_type: str | None = None
) -> QueryScalar: ...

def compile_json(source: str) -> bytes: ...
def compile_cts_json(
    source: str,
    mode: str | None = None,
    datatype_policy: str | None = None,
    rich: bool = False,
    limits_source: str | None = None,
    max_attribute_depth: int | None = None,
    max_separator_depth: int | None = None,
    max_generic_depth: int | None = None,
    max_events: int | None = None,
) -> bytes: ...
def compile_packed(
    source: str,
) -> tuple[
    list[tuple[object, ...]],
    list[tuple[object, ...]],
    list[tuple[object, ...]],
]: ...
def compile_native(source: str) -> CompileResult: ...
def canonicalize_native(
    source: str,
    ordering: str = "reference-safe-v1",
    max_ordering_edges: int = 1_000_000,
    max_attribute_depth: int = 1,
) -> tuple[bool, bytes]: ...
def compile_telex(source: str) -> tuple[bool, bytes]: ...
def compile_telex_profile(source: str) -> tuple[int, int, int, int, int, int]: ...
def pytonic_loads(
    source: str,
    datatype_policy: str | None = None,
    max_attribute_depth: int | None = None,
) -> Document: ...
