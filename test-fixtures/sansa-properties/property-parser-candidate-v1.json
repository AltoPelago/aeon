      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-quoted-ampersand",
      "description": "quoted ampersand",
      "input": {
        "operation": "parse-address",
        "source": "$.[\"&key(\\\"x\\\")\"]"
      },
      "expected": {
        "ok": true,
        "canonical": "$.[\"&key(\\\"x\\\")\"]",
        "isExact": true
      },
      "covers": [
        "legacy"
      ]
    },
    {
      "id": "sansa-properties-ordinary-qualifier",
      "description": "ordinary qualifier",
      "input": {
        "operation": "parse-address",
        "source": "$.item:thing[\"&tag\"]"
      },
      "expected": {
        "ok": true,
        "canonical": "$.item:thing[\"&tag\"]",
        "isExact": true
      },
      "covers": [
        "legacy"
      ]
    },
    {
      "id": "sansa-properties-payload-bound-0",
      "description": "payload bound 0",
      "input": {
        "operation": "parse-address",
        "generate": {
          "kind": "payload",
          "count": 4096,
          "form": "text"
        }
      },
      "expected": {
        "ok": true,
        "isExact": false
      },
      "covers": [
        "bounds"
      ]
    },
    {
      "id": "sansa-properties-payload-bound-1",
      "description": "payload bound 1",
      "input": {
        "operation": "parse-address",
        "generate": {
          "kind": "payload",
          "count": 4097,
          "form": "text"
        }
      },
      "expected": {
        "ok": false,
        "error": "SANSA_PROPERTY_LIMIT_EXCEEDED",
        "limitKind": "payloadScalars",
        "limit": 4096,
        "observed": 4097
      },
      "covers": [
        "bounds"
      ]
    },
    {
      "id": "sansa-properties-selectors-bound-0",
      "description": "selectors bound 0",
      "input": {
