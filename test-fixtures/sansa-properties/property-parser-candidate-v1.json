      "expected": {
        "ok": false,
        "error": "SANSA_EXPECTED_PROPERTY_ARGUMENT"
      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-single-quote",
      "description": "single quote",
      "input": {
        "operation": "parse-address",
        "source": "$&key('x')"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_EXPECTED_PROPERTY_ARGUMENT"
