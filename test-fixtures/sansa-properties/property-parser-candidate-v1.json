{
  "meta": {
    "suite_id": "property-parser",
    "lane": "sansa-properties",
    "capability": "SANSA.Addressing",
    "profile": "sansa-properties-read-only-candidate-0.2",
    "sut_protocol": "sansa-properties-preparation-v0.1",
    "spec_refs": [
      "aeonite-specs/sources/sansa/v1/property-selectors-v1.aeon"
    ]
  },
  "id": "property-parser",
  "title": "Property candidate parser",
  "tests": [
    {
      "id": "sansa-properties-root-key",
      "description": "root key",
      "input": {
        "operation": "parse-address",
        "source": "$&key(\"\")"
      },
      "expected": {
        "ok": true,
        "canonical": "$&key(\"\")",
        "isExact": false
      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-member-tag",
      "description": "member tag",
      "input": {
        "operation": "parse-address",
        "source": "$.document&tag(\"catalog\")"
      },
      "expected": {
        "ok": true,
        "canonical": "$.document&tag(\"catalog\")",
        "isExact": false
      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-chained",
      "description": "chained",
      "input": {
        "operation": "parse-address",
        "source": "$.document&key(\"document\")&tag(\"catalog\")[0]"
      },
      "expected": {
        "ok": true,
        "canonical": "$.document&key(\"document\")&tag(\"catalog\")[0]",
        "isExact": false
      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-unicode-escape",
      "description": "unicode escape",
      "input": {
        "operation": "parse-address",
        "source": "$&key(\"\\u{1F600}\")"
      },
      "expected": {
        "ok": true,
        "canonical": "$&key(\"\ud83d\ude00\")",
        "isExact": false
      },
      "covers": [
        "syntax",
        "unicode"
      ]
    },
    {
      "id": "sansa-properties-unicode-codepoint",
      "description": "unicode codepoint",
      "input": {
        "operation": "parse-address",
        "source": "$&key(\"\u00e9\")"
      },
      "expected": {
        "ok": true,
        "canonical": "$&key(\"\u00e9\")",
        "isExact": false
      },
      "covers": [
        "syntax",
        "unicode"
      ]
    },
    {
      "id": "sansa-properties-literal-wildcards",
      "description": "literal wildcards",
      "input": {
        "operation": "parse-address",
        "source": "$&key(\"*?\")"
      },
      "expected": {
        "ok": true,
        "canonical": "$&key(\"*?\")",
        "isExact": false
      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-argument-spaces",
      "description": "argument spaces",
      "input": {
        "operation": "parse-address",
        "source": "$&key(\"a b\")"
      },
      "expected": {
        "ok": true,
        "canonical": "$&key(\"a b\")",
        "isExact": false
      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-escape-quote",
      "description": "escape quote",
      "input": {
        "operation": "parse-address",
        "source": "$&key(\"a\\\"b\\\\c\")"
      },
      "expected": {
        "ok": true,
        "canonical": "$&key(\"a\\\"b\\\\c\")",
        "isExact": false
      },
      "covers": [
        "syntax",
        "unicode"
      ]
    },
    {
      "id": "sansa-properties-empty-tag",
      "description": "empty tag",
      "input": {
        "operation": "parse-address",
        "source": "$&tag(\"\")"
      },
      "expected": {
        "ok": true,
        "canonical": "$&tag(\"\")",
        "isExact": false
      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-unknown",
      "description": "unknown",
      "input": {
        "operation": "parse-address",
        "source": "$&Key(\"x\")"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_UNKNOWN_PROPERTY_SELECTOR"
      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-unknown-position",
      "description": "unknown position",
      "input": {
        "operation": "parse-address",
        "source": "$.*&first"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_UNKNOWN_PROPERTY_SELECTOR"
      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-missing-argument",
      "description": "missing argument",
      "input": {
        "operation": "parse-address",
        "source": "$&key()"
      },
      "expected": {
        "ok": false,
        "error": "SANSA_EXPECTED_PROPERTY_ARGUMENT"
      },
      "covers": [
        "syntax"
      ]
    },
    {
      "id": "sansa-properties-numeric-argument",
      "description": "numeric argument",
      "input": {
