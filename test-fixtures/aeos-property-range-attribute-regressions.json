  "id": "aeos-property-range-attribute-regressions",
  "tests": [
    {
      "id": "named-1-[0..]",
      "records": [
        {
          "path": "$.o",
          "kind": "ObjectNode"
        },
        {
          "path": "$.o.a",
          "kind": "StringLiteral",
          "value": "a"
        }
      ],
      "schema": {
        "rules": [
          {
            "selector": "$.o&key(\"o\")[0..]",
            "constraints": {
              "type": "NumberLiteral"
            }
          }
        ]
      },
      "expected": {
        "ok": false,
        "errors": [
          {
            "code": "type_mismatch",
            "path": "$.o.a"
          }
