  "portableTopologyCases": [
    {
      "id": "node-head-address-translation",
      "source": "value\\BINDING\\@{keyMeta\\KEY_META\\ = \"outer\"} = <tag\\HEAD\\@{role\\ROLE\\ = \"button\"}:node(\\CHILD\\ = \"hello\")>",
      "sourceToEventPaths": {
        "$.value": "$.value",
        "$.value[0]": "$.value[0][0]"
      },
      "events": [
        {
          "path": "$.value",
          "kind": "NodeLiteral",
          "identity": "BINDING"
        },
        {
          "path": "$.value.@.keyMeta",
          "kind": "StringLiteral",
          "identity": "KEY_META",
          "value": "outer"
        },
        {
          "path": "$.value[0]",
          "kind": "NodeHead",
          "identity": "HEAD",
          "datatype": "node",
          "value": "tag"
        },
        {
          "path": "$.value[0].@.role",
          "kind": "StringLiteral",
          "identity": "ROLE",
          "value": "button"
        },
        {
          "path": "$.value[0][0]",
          "kind": "StringLiteral",
          "identity": "CHILD",
          "value": "hello"
        }
      ]
    },
    {
      "id": "attribute-value-node-reference-translation",
      "source": "a@{x = <tag(1, ~a.@.x[0])>} = 1\ncopy = ~a.@.x[0]",
      "sourceToEventPaths": {
        "$.a": "$.a",
        "$.copy": "$.copy"
      },
      "events": [
        {
          "path": "$.a",
          "kind": "NumberLiteral",
          "value": "1"
        },
        {
          "path": "$.a.@.x",
          "kind": "NodeLiteral"
        },
        {
          "path": "$.a.@.x[0]",
          "kind": "NodeHead",
          "value": "tag"
        },
        {
          "path": "$.a.@.x[0][0]",
          "kind": "NumberLiteral",
          "value": "1"
        },
        {
          "path": "$.a.@.x[0][1]",
          "kind": "CloneReference",
          "value": "$.a.@.x[0][0]"
        },
        {
          "path": "$.copy",
          "kind": "CloneReference",
          "value": "$.a.@.x[0][0]"
        }
      ]
    }
  ],
