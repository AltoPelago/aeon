{
  "id": "aeon.document-projection.v1",
  "status": "local-implementation-contract",
  "addressDomains": {
    "namespace": "Document-scoped canonical navigation address; required for every binding, including synthetic roots.",
    "aeon-source": "Native compiler path domain; unavailable for synthetic NodeHead bindings.",
    "aes-event": "Portable AES occurrence-path domain; retained for event-backed bindings."
  },
  "documentGraphAddressContract": {
    "required": "namespace",
    "conditional": [
      "aeon-source",
      "aes-event"
    ],
    "sansaEventBackedDefault": "aes-event"
  },
  "namespaceSnapshotAddressDomain": "aes-event",
  "fidelityDimensions": [
    "telex-event",
    "profile-relative-semantic",
    "exact-source"
  ],
  "capabilityStates": [
    "complete",
    "partial",
    "not-supplied",
    "not-collected",
    "not-applicable"
  ],
  "capabilities": [
    {
      "id": "source.bytes",
      "description": "Exact retained AEON source bytes, including BOM and original line endings when present."
    },
    {
      "id": "source.authored-lexemes",
      "description": "Authored token spelling retained independently of canonical semantic values."
    },
    {
      "id": "provenance.origin",
      "description": "Portable origin identifiers supplied by the source or transport."
    },
    {
      "id": "provenance.span",
      "description": "Exact portable source spans supplied with matching origin identifiers."
    },
    {
      "id": "aes.portable-extensions",
      "description": "Significant portable AES extensions retained for semantic round trips."
    },
    {
      "id": "telex.unknown-fields",
      "description": "Unknown ordered Telex fields retained opaquely for compatible re-emission."
    },
    {
      "id": "aes.event-order",
      "description": "Authoritative supplied event order retained independently of tree traversal order."
    },
    {
      "id": "lineage.events",
      "description": "Bindings retain their relationship to originating or synthetic events."
    }
  ],
  "capabilityScenarios": [
    {
      "id": "complete-telex-with-provenance-without-source",
      "inputRoute": "complete-telex",
      "states": {
        "source.bytes": "not-supplied",
        "source.authored-lexemes": "not-supplied",
        "provenance.origin": "complete",
        "provenance.span": "complete",
        "aes.portable-extensions": "complete",
        "telex.unknown-fields": "complete",
        "aes.event-order": "complete",
        "lineage.events": "complete"
      }
    }
  ],
  "documentGraphRequiredFields": [
    "nodeId",
    "address",
    "sourceAddress",
    "eventAddress",
    "parentNodeId",
    "childNodeIds",
    "bindingName",
    "position",
    "sourcePlane",
    "representationKind",
    "valueKind",
    "datatype",
    "identity",
    "decodedValue",
    "canonicalLexeme",
    "authoredLexeme",
    "nullReason",
    "reference",
    "attributeSpaceNodeId",
    "origin",
    "span",
    "portableExtensions",
    "transportSidecar",
    "lineage"
  ],
  "namespaceProjectionFields": [
    "address",
